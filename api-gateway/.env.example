# API Gateway
HOST=127.0.0.1
PORT=8080

# JWT
JWT_SECRET=change-me-to-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Target Services
COIN_URL=http://127.0.0.1:8001
COIN_TOKEN=

TRAIN_URL=http://127.0.0.1:8000
TRAIN_TOKEN=

DASH_URL=http://127.0.0.1:8002
BLOG_URL=http://127.0.0.1:3100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8002

# Rate Limiting (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
