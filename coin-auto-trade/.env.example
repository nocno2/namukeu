# API 인증 토큰 (Bearer)
API_TOKEN=your-secret-token-here

# 암호화 키 (Fernet) — python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# 서버 설정
HOST=127.0.0.1
PORT=8001

# 매매 모드 (중요: 충분히 테스트 전까지 true 유지)
DRY_RUN=true

# 매매 파라미터
TRADING_INTERVAL_SECONDS=60
MAX_POSITIONS=5
MAX_LOSS_PERCENT=5.0
DEFAULT_ORDER_PERCENT=10.0

# 데이터 수집
OHLCV_COLLECT_INTERVAL_MINUTES=5
OHLCV_RETENTION_DAYS=90

# LLM 에이전트 설정 (Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
RESEARCHER_MODEL=gemini-3.1-flash-lite-preview
TECHNICIAN_MODEL=gemini-3.1-flash-lite-preview
STRATEGIST_MODEL=gemini-3.1-pro-preview
RISK_MANAGER_MODEL=gemini-3.1-pro-preview
REPORTER_MODEL=gemini-3.1-flash-lite-preview
AGENT_CYCLE_HOURS=6,10,14,18,22
AGENT_CYCLE_TIMEOUT=300
AGENT_MAX_POSITIONS=5
AGENT_MAX_POSITION_PCT=20
AGENT_MIN_CASH_RATIO=30
AGENT_MAX_DAILY_LOSS_PCT=3
AGENT_MAX_TOTAL_LOSS_PCT=5
AGENT_MAX_TRADES_PER_DAY=10
AGENT_STOP_LOSS_PCT=5
