# API 인증 토큰 (Bearer)
API_TOKEN=your-secret-token-here

# 암호화 키 (Fernet) — python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Discord 웹훅 알림 (선택)
# DISCOK_URL=https://discord.com/api/webhooks/...

# 이메일 알림 (선택) - 중요 에러 발생ORD_WEBHO 시 이메일로도 알림
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=your-email@gmail.com

# 서버 설정
HOST=127.0.0.1
PORT=8000

# 매크로 설정
SEARCH_INTERVAL_MIN=3
SEARCH_INTERVAL_MAX=8
MAX_SEARCH_DURATION_HOURS=24
PROGRESS_REPORT_MINUTES=10
