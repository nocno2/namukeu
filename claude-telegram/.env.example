# ============================================================
# Claude Telegram Relay v2
# ============================================================

# --- REQUIRED (all must be set) ---

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (from @userinfobot)
TELEGRAM_USER_ID=

# Content-pipeline API URL (e.g., http://localhost:8003)
PIPELINE_API_URL=

# Agent API token for content-pipeline authentication
AGENT_API_TOKEN=

# Blog admin URL for user-facing links (e.g., https://blog.namukeu.com/admin)
BLOG_ADMIN_URL=

# Dashboard URL (e.g., https://dashboard.namukeu.com)
DASHBOARD_URL=

# Project root path (e.g., /Users/namwook/Documents/namukeu)
PROJECT_ROOT=

# Coin auto-trade API URL (e.g., http://localhost:8001)
COIN_API_URL=

# Internal API key for coin service authentication
INTERNAL_API_KEY=

# --- RECOMMENDED ---

# Your name (used in system prompt)
USER_NAME=

# Your timezone (IANA format)
USER_TIMEZONE=Asia/Seoul

# Working directory for Claude Code agent
PROJECT_DIR=

# Project root path (used in system prompt for project context)
PROJECT_ROOT=/Users/namwook/Documents/namukeu

# --- OPTIONAL ---

# Path to claude CLI binary (auto-detected from PATH if not set)
# CLAUDE_PATH=claude

# Claude model to use
# MODEL=

# Data directory for session/memory files (default: ./data)
# DATA_DIR=./data

# Log channel ID - send log messages to separate channel (optional)
# Create a private channel and get its ID (e.g., -1001234567890)
# LOG_CHANNEL_ID=
