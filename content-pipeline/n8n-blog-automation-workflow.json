      "parameters": {
        "jsCode": "const urls = [];\nfor (const item of $input.all()) {\n  if (item.json.data && item.json.data[0]) {\n    urls.push(item.json.data[0].url);\n  }\n}\nreturn [{ json: { image_urls: urls } }];"
