# ============================================================
# Claude Discord Relay
# ============================================================

# --- REQUIRED ---

# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# Your Discord user ID (Enable Developer Mode > right-click user > Copy ID)
DISCORD_USER_ID=

# --- RECOMMENDED ---

# Your name (used in system prompt)
USER_NAME=

# Your timezone (IANA format)
USER_TIMEZONE=Asia/Seoul

# Working directory for Claude Code agent
PROJECT_DIR=

# Dedicated channels where bot responds without @mention (comma-separated channel IDs)
# DEDICATED_CHANNELS=123456789,987654321

# --- OPTIONAL ---

# Path to claude CLI binary (auto-detected from PATH if not set)
# CLAUDE_PATH=claude

# Claude model to use
# MODEL=

# Data directory for session/memory files (default: ./data)
# DATA_DIR=./data

# --- coin-auto-trade integration ---

# coin-auto-trade API URL (default: http://127.0.0.1:8001)
# COIN_API_URL=http://127.0.0.1:8001

# coin-auto-trade API Bearer token
COIN_API_TOKEN=
